# Copy this file to .env and fill in your key.

# --- LLM (answer generation) ---
# openai | claude | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
# Not every key can access every model. On a 403 model_not_found, list what
# your key allows with client.models.list() - see the README.
OPENAI_MODEL=gpt-5.5
# On gpt-5.x, reasoning tokens come out of this budget - keep it generous.
LLM_MAX_TOKENS=6000

# Only if LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-opus-5

# Only if LLM_PROVIDER=ollama (local, free)
# OLLAMA_MODEL=llama3.3
# OLLAMA_HOST=http://localhost:11434

# --- Embeddings (retrieval) ---
# openai | local
EMBED_PROVIDER=openai
OPENAI_EMBED_MODEL=text-embedding-3-small
# Only if EMBED_PROVIDER=local
# LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Chunking / retrieval / verification tuning ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=6
VERIFY_THRESHOLD=0.65
